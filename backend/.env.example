# ==========================================
# CORTEXAI CONSOLIDATED BACKEND ENVIRONMENT TEMPLATE
# Copy to .env and provide your secret values
# ==========================================

# Server Configuration
PORT=8000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# Internal Service Security Key (for secure settlement recovery & internal admin jobs)
INTERNAL_SERVICE_KEY=your_internal_service_key_min_32_chars

# MongoDB Atlas
# Connection string to your MongoDB Atlas cluster (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>.mongodb.net

# Redis / Upstash Redis
# For Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379
# For Local: redis://localhost:6379
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Firebase Admin SDK (Authentication)
# Single-line escaped JSON string of your Firebase serviceAccountKey.json
# Example: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# AI Providers
GROQ_API_KEY=gsk_your_groq_api_key
GOOGLE_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key

# Qdrant Vector Cloud (PDF RAG)
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Supabase Storage (Primary Object Storage for PDF, PPT & Images)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_BUCKET_NAME=cortexai-files
