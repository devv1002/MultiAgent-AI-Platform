# Firebase Web Client API Key (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY="your-firebase-api-key"

# Backend Server URL:
# - For local development: http://localhost:8000
# - For Vercel production with rewrites configured: leave empty ("")
VITE_SERVER_URL=""

# Razorpay Key ID (Test key from Razorpay Dashboard)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
