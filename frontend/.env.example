# Firebase Web Client API Key (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY="your-firebase-api-key"

# Backend Server URL:
# - For local development: leave empty ("") to use Vite dev proxy, or set to http://localhost:8000
# - For Vercel production: set to your deployed Render service URL (e.g. https://your-service.onrender.com)
VITE_SERVER_URL=""

# Razorpay Key ID (Test key from Razorpay Dashboard)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
